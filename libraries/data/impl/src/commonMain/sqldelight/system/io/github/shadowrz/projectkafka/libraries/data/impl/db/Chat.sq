lastInsertRowId:
SELECT last_insert_rowid();

chats:
SELECT
    chat.id AS id,
    chat.name AS name,
    chat.creatorId AS creatorID,
    chat.avatar AS avatar,
    member.id AS directID,
    member.name AS directName,
    member.description AS directDescription,
    member.avatar AS directAvatar,
    member.cover AS directCover,
    member.preferences AS directPreferences,
    member.roles AS directRoles,
    member.birth AS directBirth,
    member.admin AS directAdmin
FROM chat
LEFT JOIN
    member ON member.id = chat.directId
LIMIT :limit OFFSET :offset;

chatsCount:
SELECT COUNT(*) FROM chat;

chatDetail:
SELECT
    chat.id AS id,
    chat.name AS name,
    chat.creatorId AS creatorID,
    chat.avatar AS avatar,
    member.id AS directID,
    member.name AS directName,
    member.description AS directDescription,
    member.avatar AS directAvatar,
    member.cover AS directCover,
    member.preferences AS directPreferences,
    member.roles AS directRoles,
    member.birth AS directBirth,
    member.admin AS directAdmin
FROM chat
LEFT JOIN
    member ON member.id = chat.directId
WHERE chat.id = :id;

insertChat:
INSERT INTO chat VALUES ?;

updateChat:
REPLACE INTO chat VALUES ?;

removeChat:
DELETE FROM chat WHERE id = ?;

messagesForward:
SELECT
    message.id AS id,
    memberId,
    media,
    timestamp,
    narrator,
    messageFtsContent.content AS content,
    member.name AS memberName,
    member.description AS memberDescription,
    member.avatar AS memberAvatar,
    member.cover AS memberCover,
    member.preferences AS memberPreferences,
    member.roles AS memberRoles,
    member.birth AS memberBirth,
    member.admin AS memberAdmin
FROM message
INNER JOIN
    messageFtsContent ON messageFtsContent.rowid = message.contentId
INNER JOIN
    member ON member.id = message.memberId
WHERE chatId = :chatId
AND (message.id > :anchor OR :anchor IS NULL)
ORDER BY timestamp ASC
LIMIT :limit;

messagesBackward:
SELECT
    message.id AS id,
    memberId,
    media,
    timestamp,
    narrator,
    messageFtsContent.content AS content,
    member.name AS memberName,
    member.description AS memberDescription,
    member.avatar AS memberAvatar,
    member.cover AS memberCover,
    member.preferences AS memberPreferences,
    member.roles AS memberRoles,
    member.birth AS memberBirth,
    member.admin AS memberAdmin
FROM message
INNER JOIN
    messageFtsContent ON messageFtsContent.rowid = message.contentId
INNER JOIN
    member ON member.id = message.memberId
WHERE chatId = :chatId
AND (message.id < :anchor OR :anchor IS NULL)
ORDER BY timestamp ASC
LIMIT :limit;

